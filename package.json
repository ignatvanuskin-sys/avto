{
  "name": "booking-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-tenant PWA for online booking in car service and detailing businesses. One static build, one Supabase project, many studios.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "dev": "vite",
    "build": "npm run tenant:publish -- --all && tsc --noEmit && vite build && npm run tenant:finalize -- --all",
    "preview": "vite preview",
    "assets:demo": "node scripts/tools/make-demo-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/ci/db-tests.ts",
    "test:e2e": "playwright test",
    "tenant:new": "tsx scripts/tenant/new.ts",
    "tenant:validate": "tsx scripts/tenant/validate.ts",
    "tenant:publish": "tsx scripts/tenant/publish.ts",
    "tenant:verify": "tsx scripts/tenant/verify.ts",
    "tenant:finalize": "tsx scripts/tenant/finalize.ts",
    "tenant:seed": "tsx scripts/tenant/build-seed.ts",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:push": "npx supabase db push",
    "supabase:test": "npx supabase test db"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.6",
    "@astryxdesign/theme-neutral": "^0.6.6",
    "@base-ui/react": "^1.9.0",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.54.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
