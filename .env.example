# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Everything below is a placeholder. The file contains no real secret.
# See SETUP.md for where each value comes from.
# =============================================================================

# -----------------------------------------------------------------------------
# Browser-side (bundled into the static frontend — these are PUBLIC values)
# -----------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The `anon` public key. It is safe in the bundle: anon holds no table grants
# and can only call the public read RPCs.
VITE_SUPABASE_ANON_KEY=

# Public half of the VAPID key pair, base64url. Generate with:
#   npx web-push generate-vapid-keys --json
# Leave empty to ship without push: the interface then says so honestly and
# every other channel keeps working.
VITE_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Pipeline / server-side (used by scripts and Edge Functions — NEVER expose)
# -----------------------------------------------------------------------------
# Used by `tenant:publish` and `tenant:verify` to apply configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, used by `tenant:verify` to prove anon cannot read private tables.
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Edge Function secrets
# -----------------------------------------------------------------------------
# Secret that signs customer access tokens. Access tokens are derived as
# HMAC-SHA256(TOKEN_HMAC_SECRET, tenantId ":" bookingId) and only their SHA-256
# hash is stored. Changing this value invalidates every issued access link, so
# treat it as long-lived and back it up. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_HMAC_SECRET=

# Shared secret the cron caller must present in the `x-cron-secret` header.
# Generate the same way as TOKEN_HMAC_SECRET.
CRON_SECRET=

# Private half of the VAPID pair, base64url. Required for Web Push.
VAPID_PRIVATE_KEY=
# Contact address published in the VAPID JWT, e.g. mailto:ops@example.com
VAPID_SUBJECT=

# Comma-separated list of origins allowed to call the Edge Functions,
# e.g. https://booking.example.com,https://graphite.example.com
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# LLM assistant (optional — ordinary booking works without it)
# -----------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
